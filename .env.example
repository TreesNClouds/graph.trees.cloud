# v2.trees.cloud — sibling of monorepo.trees.clouds
# Other stack credentials still overlay from
# ../monorepo.trees.clouds/apps/api.trees.cloud/.env

PORT=3400
CORS_ORIGIN=http://localhost:3401
API_TREES_CLOUD_URL=http://127.0.0.1:3333

# Supabase (same project as api.trees.cloud — copy from that .env)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Google OAuth uses the existing Supabase Auth provider.
# Add this exact redirect to Authentication → URL Configuration:
#   http://localhost:3401/confirm
#   https://<this-host>/confirm

# Authorize.net (same keys as app.trees.cloud / api.trees.cloud)
# Server keys overlay from the monorepo api .env if unset.
# AUTHORIZE_NET_API_LOGIN_ID=
# AUTHORIZE_NET_API_TRANSACTION_KEY=
# AUTHORIZE_NET_API_ENDPOINT=https://apitest.authorize.net/xml/v1/request.api
# NEXT_PUBLIC_AUTHORIZE_NET_PUBLIC_CLIENT_KEY=
# NEXT_PUBLIC_AUTHORIZE_NET_API_LOGIN_ID=
# APP_MODE=development
